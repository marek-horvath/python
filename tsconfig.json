{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@weeks/*": ["weeks/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "weeks/**/*.ts",
    "scripts/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.astro"
  ]
}
