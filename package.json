{
  "name": "programovanie-v-pythone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repozitár predmetu Programovanie v Pythone pre TUKE FEI.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host 127.0.0.1",
    "dev:stop": "node scripts/run-astro.mjs dev stop",
    "dev:status": "node scripts/run-astro.mjs dev status",
    "dev:logs": "node scripts/run-astro.mjs dev logs",
    "build": "npm run validate && npm run build:web",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/deploy-gh-pages.mjs",
    "build:web": "node scripts/run-astro.mjs build",
    "export:pptx": "tsx scripts/export-pptx.ts",
    "validate": "tsx scripts/validate.ts",
    "audit:visual": "node scripts/visual-audit.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "astro": "^7.2.9",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
