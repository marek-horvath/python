---
import { previewStorageKey } from "@shared/publication";
---

<div class="preview-indicator" data-preview-indicator data-preview-key={previewStorageKey} hidden>
  <span data-i18n-key="preview.indicator">Náhľad vyučujúceho</span>
  <span aria-hidden="true">·</span>
  <button type="button" data-preview-exit data-i18n-key="preview.exit">Ukončiť</button>
</div>

<script>
  const previewRoot = document.querySelector<HTMLElement>("[data-preview-indicator]");
  const previewStorageKey = previewRoot?.dataset.previewKey ?? "pythonCoursePreviewMode";

  function hasPreviewMode() {
    try {
      return sessionStorage.getItem(previewStorageKey) === "enabled";
    } catch {
      return false;
    }
  }

  function setLockedLinkState(link: HTMLElement, active: boolean) {
    if (active) {
      link.removeAttribute("aria-disabled");
      link.removeAttribute("tabindex");
      link.classList.remove("is-locked");
    } else {
      link.setAttribute("aria-disabled", "true");
      link.setAttribute("tabindex", "-1");
      link.classList.add("is-locked");
    }
  }

  function applyPreviewMode() {
    const active = hasPreviewMode();
    document.documentElement.toggleAttribute("data-preview-mode", active);

    document.querySelectorAll<HTMLElement>("[data-preview-indicator]").forEach((element) => {
      element.hidden = !active;
    });

    document.querySelectorAll<HTMLElement>("[data-preview-link]").forEach((link) => {
      setLockedLinkState(link, active);
    });

    document.querySelectorAll<HTMLElement>("[data-preview-visible]").forEach((element) => {
      element.hidden = !active;
    });

    document.querySelectorAll<HTMLElement>("[data-preview-hidden]").forEach((element) => {
      element.hidden = active;
    });

    document.querySelectorAll<HTMLElement>("[data-preview-material]").forEach((element) => {
      element.hidden = !active;
    });

    document.querySelectorAll<HTMLElement>("[data-preview-locked]").forEach((element) => {
      element.hidden = active;
    });

    if (active && document.querySelector("[data-preview-material]")) {
      document.documentElement.classList.add("viewer-html");
      window.dispatchEvent(new Event("resize"));
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-preview-exit]").forEach((button) => {
    button.addEventListener("click", () => {
      try {
        sessionStorage.removeItem(previewStorageKey);
      } catch {
        // Preview mode is only a local browser convenience.
      }
      applyPreviewMode();
      if (document.querySelector("[data-preview-material]")) window.location.reload();
    });
  });

  window.addEventListener("preview-mode-change", applyPreviewMode);
  applyPreviewMode();
</script>
