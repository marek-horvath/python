      <p><a href="https://docs.python.org/3/tutorial/classes.html" target="_blank" rel="noreferrer"><LocalizedText sk="Oficiálna dokumentácia Pythonu: Triedy" en="Official Python documentation: Classes" /></a></p>
    </footer>
  </main>
</BaseLayout>

<script>
  // Include answers hidden in <details> when exporting the page to PDF.
  // Restore the user's original open/closed states after the print dialog closes.
  let previousDetailsState: Array<{ element: HTMLDetailsElement; wasOpen: boolean }> | null = null;

  const openDetailsForPrint = () => {
    const details = Array.from(document.querySelectorAll<HTMLDetailsElement>(".oop-page details"));
    previousDetailsState = details.map((element) => ({
      element,
      wasOpen: element.open,
    }));
    details.forEach((element) => {
      element.open = true;
    });
  };

  const restoreDetailsAfterPrint = () => {
    if (!previousDetailsState) return;
    previousDetailsState.forEach(({ element, wasOpen }) => {
      element.open = wasOpen;
    });
    previousDetailsState = null;
  };

  window.addEventListener("beforeprint", openDetailsForPrint);
  window.addEventListener("afterprint", restoreDetailsAfterPrint);

  document.querySelector<HTMLButtonElement>("#oop-print")?.addEventListener("click", () => {
    window.print();
  });
</script>
