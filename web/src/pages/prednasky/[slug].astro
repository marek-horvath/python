---
import { courseConfig } from "@shared/course.config";
import { localizedCourse } from "@shared/i18n";
import { presentations } from "@shared/presentations";
import { isMaterialReleased } from "@shared/publication";
import type { Presentation } from "@shared/presentations";
import I18nController from "../../components/I18nController.astro";
import LanguageBoot from "../../components/LanguageBoot.astro";
import LectureViewer from "../../components/LectureViewer.astro";
import PreviewIndicator from "../../components/PreviewIndicator.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { getPresentationRender } from "../../lib/presentation-manifest";
import "../../styles/global.css";

export function getStaticPaths() {
  return presentations.map((presentation) => ({
    params: { slug: presentation.slug },
    props: { presentation }
  }));
}

type Props = {
  presentation: Presentation;
};

const { presentation } = Astro.props;
const render = getPresentationRender(presentation.slug);
const internalUrl = (href: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${href.replace(/^\//, "")}`;
const released = isMaterialReleased(presentation.weekNumber);
const orderedPresentations = [...presentations].sort((a, b) => a.weekNumber - b.weekNumber);
const presentationIndex = orderedPresentations.findIndex((item) => item.weekNumber === presentation.weekNumber);
const previousPresentation = presentationIndex > 0 ? orderedPresentations[presentationIndex - 1] : undefined;
const nextPresentation = presentationIndex >= 0 && presentationIndex < orderedPresentations.length - 1 ? orderedPresentations[presentationIndex + 1] : undefined;
const previous = previousPresentation
  ? {
      number: previousPresentation.weekNumber,
      labelKey: "lecture.previousLabel",
      title: previousPresentation.title,
      titleEn: previousPresentation.titleEn,
      href: `/prednasky/${previousPresentation.slug}/`
    }
  : undefined;
const next = nextPresentation
  ? {
      number: nextPresentation.weekNumber,
      labelKey: "lecture.nextLabel",
      title: nextPresentation.title,
      titleEn: nextPresentation.titleEn,
      href: `/prednasky/${nextPresentation.slug}/`
    }
  : undefined;
---

<!doctype html>
<html
  lang="sk"
  class={released ? "viewer-html" : undefined}
  data-title-sk={`${presentation.title} | ${localizedCourse.title.sk}`}
  data-title-en={`${presentation.titleEn} | ${localizedCourse.title.en}`}
  data-description-sk={presentation.description}
  data-description-en={presentation.description}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={presentation.description} />
    <title>{presentation.title} | {localizedCourse.title.sk}</title>
    <LanguageBoot />
  </head>
  <body>
    {
      released ? (
        <LectureViewer presentation={presentation} render={render} previous={previous} next={next} />
      ) : (
        <>
          <div class="site-shell" data-preview-locked>
            <SiteHeader />
            <main class="page text-page locked-material">
              <h1 data-i18n-key="lecture.lockedTitle">Materiál zatiaľ nie je zverejnený.</h1>
              <p><a href={internalUrl("/prednasky/")} data-i18n-key="ui.backLectures">← Späť na prednášky</a></p>
            </main>
            <footer class="site-footer">
              <p>
                <strong data-i18n-key="course.title">{localizedCourse.title.sk}</strong><br />
                {courseConfig.lecturer.name} · <a href={`mailto:${courseConfig.lecturer.email}`}>{courseConfig.lecturer.email}</a><br />
                <span data-i18n-key="course.university">{localizedCourse.university.sk}</span>
              </p>
            </footer>
          </div>
          <div data-preview-material hidden>
            <LectureViewer presentation={presentation} render={render} previous={previous} next={next} />
          </div>
        </>
      )
    }
    <PreviewIndicator />
    <I18nController />
  </body>
</html>
