---
import { courseConfig } from "@shared/course.config";
import { previewStorageKey } from "@shared/publication";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Náhľad vyučujúceho" titleEn="Teacher Preview">
  <main class="page text-page admin-page">
    <h1 data-i18n-key="admin.title">Náhľad vyučujúceho</h1>
    <p data-i18n-key="admin.description">Toto je iba lokálny preview režim pre kontrolu existujúcich materiálov pred zverejnením.</p>

    <form class="admin-form" data-preview-form data-preview-key={previewStorageKey} data-password={courseConfig.adminPreviewPassword}>
      <label for="preview-password" data-i18n-key="admin.password">Heslo</label>
      <input id="preview-password" name="password" type="password" autocomplete="current-password" />
      <button type="submit" data-i18n-key="admin.unlock">Odomknúť všetky materiály</button>
      <p class="form-message" data-preview-message aria-live="polite"></p>
    </form>

    <p class="preview-active-message" data-admin-active hidden>
      <span data-i18n-key="admin.active">Náhľad je aktívny pre túto browser session.</span>
      <button type="button" data-admin-exit data-i18n-key="admin.exitPreview">Ukončiť náhľad</button>
    </p>
  </main>

  <script>
    type I18nApi = {
      t: (key: string) => string;
      applyLanguage: () => void;
    };

    function i18n() {
      return (window as Window & { pythonCourseI18n?: I18nApi }).pythonCourseI18n;
    }

    function t(key: string, fallback: string) {
      return i18n()?.t(key) ?? fallback;
    }

    const form = document.querySelector<HTMLFormElement>("[data-preview-form]");
    const input = document.querySelector<HTMLInputElement>("#preview-password");
    const message = document.querySelector<HTMLElement>("[data-preview-message]");
    const activeMessage = document.querySelector<HTMLElement>("[data-admin-active]");
    const exitButton = document.querySelector<HTMLButtonElement>("[data-admin-exit]");
    const previewStorageKey = form?.dataset.previewKey ?? "pythonCoursePreviewMode";

    function isPreviewActive() {
      try {
        return sessionStorage.getItem(previewStorageKey) === "enabled";
      } catch {
        return false;
      }
    }

    function updateState() {
      const active = isPreviewActive();
      if (activeMessage) activeMessage.hidden = !active;
      i18n()?.applyLanguage();
      window.dispatchEvent(new Event("preview-mode-change"));
    }

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const expected = form.getAttribute("data-password");

      if (input?.value === expected) {
        try {
          sessionStorage.setItem(previewStorageKey, "enabled");
        } catch {
          // Preview mode is only a local browser convenience.
        }
        if (message) message.textContent = t("admin.activeShort", "Náhľad je aktívny.");
        updateState();
      } else if (message) {
        message.textContent = t("admin.invalidPassword", "Nesprávne heslo.");
      }
    });

    exitButton?.addEventListener("click", () => {
      try {
        sessionStorage.removeItem(previewStorageKey);
      } catch {
        // Preview mode is only a local browser convenience.
      }
      if (message) message.textContent = t("admin.closed", "Náhľad bol ukončený.");
      updateState();
    });

    updateState();
  </script>
</BaseLayout>
