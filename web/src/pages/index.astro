---
import { courseConfig } from "@shared/course.config";
import {
  academicResourceTranslations,
  localizedCourse,
  translate,
  type I18nDictionary,
  weekTitleTranslations
} from "@shared/i18n";
import { formatLectureDate, isWeekReleased } from "@shared/publication";
import { lectures } from "@shared/lectures";
import { weeks } from "@shared/weeks";
import { getCourseCountdown, selfStudyNotice } from "@shared/schedule";
import { courseCountdownText, finalAssessment } from "@shared/project-assessment";
import FinalAssessmentNotice from "../components/FinalAssessmentNotice.astro";
import LocalizedText from "../components/LocalizedText.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const countdownState = getCourseCountdown(weeks, courseConfig.project.finalSubmissionAt);
const activeWeek = countdownState.stage === "lecture" ? countdownState.week : undefined;
const nextDate = new Date(activeWeek?.lectureAt ?? courseConfig.project.finalSubmissionAt);
const countdownText = courseCountdownText[countdownState.stage];
const activeWeekTitles = activeWeek
  ? weekTitleTranslations[activeWeek.number] ?? { sk: activeWeek.title, en: activeWeek.title }
  : { sk: "", en: "" };
const announcementEndpoint = import.meta.env.PUBLIC_ANALYTICS_API_URL ?? (process.env.GITHUB_PAGES === "true" ? "" : "/api/analytics");
const lectureSchedule = weeks.map((week) => ({
  number: week.number,
  lectureAt: week.lectureAt,
  lectureMode: week.lectureMode,
  titles: weekTitleTranslations[week.number] ?? { sk: week.title, en: week.title }
}));

const homeTranslations = {
  "home.lead": {
    sk: "Python je univerzálny programovací jazyk používaný pri vývoji aplikácií, automatizácii, spracovaní dát, komunikácii s webovými službami a v ďalších oblastiach informatiky. Predmet je zameraný na praktické využitie Pythonu a jeho ekosystému pri riešení rôznych typov programátorských problémov.",
    en: "Python is a general-purpose programming language used for application development, automation, data processing, communication with web services and many other areas of computing. The course focuses on practical use of Python and its ecosystem for solving different kinds of programming problems."
  },
  "home.selfStudy": selfStudyNotice,
  "home.projectLink": { sk: "Pokyny k odovzdaniu a obhajobe", en: "Submission and defence instructions" },
  "home.semesterKicker": { sk: "Semester", en: "Semester" },
  "home.semesterTitle": { sk: "Program semestra", en: "Semester Plan" },
  "home.infoAria": { sk: "Organizačné informácie a zdroje", en: "Organizational information and resources" },
  "home.infoKicker": { sk: "Informácie", en: "Information" },
  "home.lectures": { sk: "Prednášky", en: "Lectures" },
  "home.exercises": { sk: "Cvičenia", en: "Exercises" },
  "home.online": { sk: "online", en: "online" },
  "home.connection": { sk: "Pripojenie", en: "Connection" },
  "home.connectionInfo": { sk: "MS Teams · kód tímu: izbx6z5", en: "MS Teams · team code: izbx6z5" },
  "home.lecturer": { sk: "Vyučujúci", en: "Lecturer" },
  "home.contact": { sk: "Kontakt", en: "Contact" },
  "home.resourcesKicker": { sk: "Doplňujúce zdroje", en: "Additional Resources" },
  ...Object.fromEntries(
    Object.entries(weekTitleTranslations).map(([number, value]) => [`week.${number}.title`, value])
  ),
  ...Object.fromEntries(
    Object.entries(academicResourceTranslations).map(([title, value]) => [`resource.${title}.description`, value])
  )
} satisfies I18nDictionary;
---

<BaseLayout i18n={homeTranslations}>
  <main class="home-page">
    <section class="home-opening" aria-labelledby="home-title">
      <div class="home-opening__text">
        <h1 id="home-title" data-i18n-key="course.title">{localizedCourse.title.sk}</h1>
        <p class="home-lead" data-i18n-key="home.lead">
          {translate(homeTranslations, "home.lead", "sk")}
        </p>
      </div>

      <aside
        class="next-lecture"
        data-next-lecture
        data-countdown-stage={countdownState.stage}
        data-week-schedule={JSON.stringify(lectureSchedule)}
        data-timezone={courseConfig.timezone}
        aria-label={countdownText.label.sk}
      >
        <p class="next-lecture__label" data-next-label>{countdownText.label.sk}</p>
        <div class="next-lecture__date-row">
          <p class="next-lecture__day" data-next-day>{countdownState.stage === "defence" ? courseConfig.project.defencePeriod.sk : new Intl.DateTimeFormat("sk-SK", { timeZone: courseConfig.timezone, day: "numeric", month: "numeric", year: "numeric" }).format(nextDate)}</p>
          <p class="next-lecture__time" data-next-time hidden={countdownState.stage === "defence"}>{new Intl.DateTimeFormat("sk-SK", { timeZone: courseConfig.timezone, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(nextDate)}</p>
        </div>
        <div class="next-lecture__topic">
          <p class="next-lecture__number" data-next-number hidden={!activeWeek}>
            {activeWeek ? String(activeWeek.number).padStart(2, "0") : ""}
          </p>
          <p class="next-lecture__title" data-next-title>
            {activeWeekTitles.sk || ("title" in countdownText ? countdownText.title.sk : "")}
          </p>
        </div>
        <p class="countdown-value" data-countdown hidden={countdownState.stage === "defence"}></p>
        <p class="next-lecture__mode" data-next-mode hidden={activeWeek?.lectureMode !== "self-study"} data-i18n-key="home.selfStudy">{selfStudyNotice.sk}</p>
        <p class="next-lecture__empty" data-next-note hidden={countdownState.stage === "lecture"}>{"note" in countdownText ? countdownText.note.sk : ""}</p>
        <p class="next-lecture__project-link" data-project-link hidden={countdownState.stage === "lecture"}><a href="/projekt/#final" data-i18n-key="home.projectLink">Pokyny k odovzdaniu a obhajobe</a></p>
      </aside>
    </section>

    <aside
      class="course-announcement"
      data-course-announcement
      data-announcement-endpoint={announcementEndpoint}
      aria-labelledby="course-announcement-title"
    >
      <strong id="course-announcement-title">
        <span data-lang="sk">Oznam</span>
        <span data-lang="en" hidden>Notice</span>
      </strong>
      <p data-lang="sk" data-announcement-sk>
        {finalAssessment.summary.sk}
      </p>
      <p data-lang="en" data-announcement-en hidden>
        {finalAssessment.summary.en}
      </p>
    </aside>

    <section class="semester-band" aria-labelledby="semester-title">
      <div class="semester-layout">
        <div class="semester-heading">
          <p class="section-kicker" data-i18n-key="home.semesterKicker">Semester</p>
          <h2 id="semester-title" data-i18n-key="home.semesterTitle">Program semestra</h2>
        </div>

        <ol class="semester-index">
          {
            weeks.map((week) => {
              const lecture = lectures.find((item) => item.weekNumber === week.number);
              const released = isWeekReleased(week.number);
              const dateLabel = formatLectureDate(week.lectureAt, "sk");
              const isCurrent = week.number === activeWeek?.number;
              const titleKey = `week.${week.number}.title`;

              return (
                <li data-semester-week={week.number} aria-current={isCurrent ? "true" : undefined} class:list={["semester-item", { "is-current": isCurrent, "is-unreleased": !released }]}>
                  <span class="semester-item__number">{String(week.number).padStart(2, "0")}</span>
                  <span class="semester-item__body">
                    {lecture && released ? (
                      <a href={`/prednasky/${lecture.slug}/`} data-i18n-key={titleKey}>{week.title}</a>
                    ) : (
                      <strong data-i18n-key={titleKey}>{week.title}</strong>
                    )}
                    {dateLabel && <small data-localized-date={week.lectureAt}>{dateLabel}</small>}
                    {!released && <small class="availability" data-i18n-key="ui.unavailable">zatiaľ nedostupné</small>}
                  </span>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    <section class="home-project-notice" aria-labelledby="home-project-title">
      <h2 id="home-project-title"><LocalizedText {...finalAssessment.title} /></h2>
      <FinalAssessmentNotice />
      <p><a href="/projekt/#final"><LocalizedText sk="Úplné zadanie a kritériá hodnotenia" en="Full assignment and grading criteria" /></a></p>
    </section>

    <section class="home-bottom" aria-label={translate(homeTranslations, "home.infoAria", "sk")} data-i18n-aria-label="home.infoAria">
      <div class="home-bottom__info">
        <p class="section-kicker" data-i18n-key="home.infoKicker">Informácie</p>
        <dl class="home-facts">
          <div>
            <dt data-i18n-key="home.lectures">Prednášky</dt>
            <dd data-i18n-key="home.online">online</dd>
          </div>
          <div>
            <dt data-i18n-key="home.exercises">Cvičenia</dt>
            <dd data-i18n-key="home.online">online</dd>
          </div>
          <div>
            <dt data-i18n-key="home.connection">Pripojenie</dt>
            <dd data-i18n-key="home.connectionInfo">MS Teams · kód tímu: izbx6z5</dd>
          </div>
          <div>
            <dt data-i18n-key="home.lecturer">Vyučujúci</dt>
            <dd>{courseConfig.lecturer.name}</dd>
          </div>
          <div>
            <dt data-i18n-key="home.contact">Kontakt</dt>
            <dd><a href={`mailto:${courseConfig.lecturer.email}`}>{courseConfig.lecturer.email}</a></dd>
          </div>
        </dl>
      </div>

      <div class="home-bottom__resources">
        <p class="section-kicker" data-i18n-key="home.resourcesKicker">Doplňujúce zdroje</p>
        <ul class="academic-links">
          {
            courseConfig.academicResources.map((resource) => (
              <li>
                <span class="academic-links__university">{resource.university}</span>
                <span class="academic-links__course">
                  <a href={resource.href} target="_blank" rel="noreferrer">{resource.title}</a>
                  <small data-i18n-key={`resource.${resource.title}.description`}>{resource.description}</small>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <script>
    import { getCourseCountdown } from "@shared/schedule";
    import { courseConfig } from "@shared/course.config";
    import { courseCountdownText } from "@shared/project-assessment";
    type Language = "sk" | "en";
    type I18nApi = {
      language: Language;
      t: (key: string) => string;
    };

    const root = document.querySelector<HTMLElement>("[data-next-lecture]");
    const number = root?.querySelector<HTMLElement>("[data-next-number]");
    const label = root?.querySelector<HTMLElement>("[data-next-label]");
    const title = root?.querySelector<HTMLElement>("[data-next-title]");
    const day = root?.querySelector<HTMLElement>("[data-next-day]");
    const time = root?.querySelector<HTMLElement>("[data-next-time]");
    const countdown = root?.querySelector<HTMLElement>("[data-countdown]");
    const note = root?.querySelector<HTMLElement>("[data-next-note]");
    const projectLink = root?.querySelector<HTMLElement>("[data-project-link]");
    const mode = root?.querySelector<HTMLElement>("[data-next-mode]");
    const timezone = root?.getAttribute("data-timezone") ?? "Europe/Bratislava";
    const schedule = JSON.parse(root?.getAttribute("data-week-schedule") ?? "[]") as Array<{
      number: number;
      lectureAt: string | null;
      lectureMode: "online" | "self-study";
      titles: Partial<Record<Language, string>>;
    }>;

    function i18n() {
      return (window as Window & { pythonCourseI18n?: I18nApi }).pythonCourseI18n;
    }

    function currentLanguage(): Language {
      return i18n()?.language ?? (document.documentElement.lang === "en" ? "en" : "sk");
    }

    function locale() {
      return currentLanguage() === "en" ? "en-GB" : "sk-SK";
    }

    function formatDay(value: Date) {
      return new Intl.DateTimeFormat(locale(), {
        timeZone: timezone,
        day: "numeric",
        month: currentLanguage() === "en" ? "short" : "numeric",
        year: "numeric"
      }).format(value);
    }

    function formatTime(value: Date) {
      return new Intl.DateTimeFormat(locale(), {
        timeZone: timezone,
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23"
      }).format(value);
    }

    function updateStaticDates() {
      document.querySelectorAll<HTMLElement>("[data-localized-date]").forEach((element) => {
        const value = element.dataset.localizedDate;
        if (!value) return;
        const date = new Date(value);
        if (!Number.isFinite(date.getTime())) return;
        element.textContent = `${formatDay(date)} · ${formatTime(date)}`;
      });
    }

    function plural(value: number, one: string, many: string) {
      return value === 1 ? one : many;
    }

    function formatCountdown(diff: number) {
      const language = currentLanguage();
      const totalMinutes = Math.max(0, Math.ceil(diff / 60000));
      const days = Math.floor(totalMinutes / (60 * 24));
      const hours = Math.floor((totalMinutes - days * 60 * 24) / 60);
      const minutes = totalMinutes % 60;

      if (language === "en") {
        const parts = [];
        if (days > 0) parts.push(`${days} ${plural(days, "day", "days")}`);
        if (hours > 0 || days > 0) parts.push(`${hours} h`);
        if (days === 0) parts.push(`${minutes} min`);
        return `in ${parts.join(" · ")}`;
      }

      const parts = [];
      if (days > 0) parts.push(`${days} dní`);
      if (hours > 0 || days > 0) parts.push(`${hours} hod`);
      if (days === 0) parts.push(`${minutes} min`);
      return `o ${parts.join(" · ")}`;
    }

    function renderCountdown() {
      const language = currentLanguage();
      const now = Date.now();
      const state = getCourseCountdown(schedule, courseConfig.project.finalSubmissionAt, now);
      const next = state.stage === "lecture" ? state.week : undefined;
      const nextDate = new Date(next?.lectureAt ?? courseConfig.project.finalSubmissionAt);
      const text = courseCountdownText[state.stage];
      if (root) {
        root.dataset.countdownStage = state.stage;
        root.setAttribute("aria-label", text.label[language]);
      }
      if (label) label.textContent = text.label[language];
      document.querySelectorAll<HTMLElement>("[data-semester-week]").forEach((item) => {
        const current = Number(item.dataset.semesterWeek) === next?.number;
        item.classList.toggle("is-current", current);
        if (current) item.setAttribute("aria-current", "true");
        else item.removeAttribute("aria-current");
      });
      if (mode) mode.hidden = next?.lectureMode !== "self-study";

      if (number) {
        number.hidden = !next;
        number.textContent = next ? String(next.number).padStart(2, "0") : "";
      }
      if (title) {
        title.hidden = false;
        title.textContent = next ? next.titles[language] ?? next.titles.sk ?? "" : "title" in text ? text.title[language] : "";
      }
      if (day) {
        day.hidden = false;
        day.textContent = state.stage === "defence" ? courseConfig.project.defencePeriod[language] : formatDay(nextDate);
      }
      if (time) {
        time.hidden = state.stage === "defence";
        time.textContent = formatTime(nextDate);
      }
      if (countdown) {
        countdown.hidden = state.stage === "defence";
        countdown.textContent = state.stage === "defence" ? "" : formatCountdown(nextDate.getTime() - now);
      }
      if (note) {
        note.hidden = state.stage === "lecture";
        note.textContent = "note" in text ? text.note[language] : "";
      }
      if (projectLink) projectLink.hidden = state.stage === "lecture";
    }

    function renderLocalizedCountdown() {
      updateStaticDates();
      renderCountdown();
    }

    renderLocalizedCountdown();
    window.setInterval(renderCountdown, 1000);
    window.addEventListener("python-course-language-change", renderLocalizedCountdown);
    window.addEventListener("python-course-language-applied", renderLocalizedCountdown);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) renderCountdown();
    });
  </script>

  <script>
    type Announcement = {
      enabled?: boolean;
      message_sk?: string;
      message_en?: string;
    };

    const announcement = document.querySelector<HTMLElement>("[data-course-announcement]");
    const endpoint = announcement?.dataset.announcementEndpoint?.replace(/\/$/, "");

    async function loadAnnouncement() {
      if (!announcement || !endpoint) return;

      try {
        const response = await fetch(`${endpoint}/announcement`, {
          credentials: "omit",
          cache: "no-store"
        });
        if (!response.ok) return;

        const settings = await response.json() as Announcement;
        announcement.hidden = settings.enabled === false;
        if (settings.enabled === false) return;

        const slovak = announcement.querySelector<HTMLElement>("[data-announcement-sk]");
        const english = announcement.querySelector<HTMLElement>("[data-announcement-en]");
        if (slovak && settings.message_sk) slovak.textContent = settings.message_sk;
        if (english && settings.message_en) english.textContent = settings.message_en;
      } catch {
        // The default notice remains visible when the optional backend is unavailable.
      }
    }

    void loadAnnouncement();
  </script>
</BaseLayout>
