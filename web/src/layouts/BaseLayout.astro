---
import { localizedCourse } from "@shared/i18n";
import type { I18nDictionary } from "@shared/i18n";
import { courseConfig } from "@shared/course.config";
import BasePathLinks from "../components/BasePathLinks.astro";
import ExerciseEnhancements from "../components/ExerciseEnhancements.astro";
import I18nController from "../components/I18nController.astro";
import LanguageBoot from "../components/LanguageBoot.astro";
import PreviewIndicator from "../components/PreviewIndicator.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  titleEn?: string;
  description?: string;
  descriptionEn?: string;
  i18n?: I18nDictionary;
};

const pageTitleSk = Astro.props.title ? `${Astro.props.title} | ${localizedCourse.title.sk}` : localizedCourse.title.sk;
const pageTitleEn = Astro.props.titleEn ? `${Astro.props.titleEn} | ${localizedCourse.title.en}` : localizedCourse.title.en;
const descriptionSk = Astro.props.description ?? localizedCourse.description.sk;
const descriptionEn = Astro.props.descriptionEn ?? localizedCourse.description.en;
---

<!doctype html>
<html
  lang="sk"
  data-title-sk={pageTitleSk}
  data-title-en={pageTitleEn}
  data-description-sk={descriptionSk}
  data-description-en={descriptionEn}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descriptionSk} />
    <title>{pageTitleSk}</title>
    <LanguageBoot />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />
      <PreviewIndicator />
      <slot />
      <footer class="site-footer">
        <p>
          <strong data-i18n-key="course.title">{localizedCourse.title.sk}</strong><br />
          {courseConfig.lecturer.name} ·
          <a href={`mailto:${courseConfig.lecturer.email}`}>{courseConfig.lecturer.email}</a><br />
          <span data-i18n-key="course.university">{localizedCourse.university.sk}</span>
        </p>
      </footer>
    </div>
    <I18nController translations={Astro.props.i18n} />
    <ExerciseEnhancements />
    <BasePathLinks />
  </body>
</html>
